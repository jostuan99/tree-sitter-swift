{
  "name": "tree-sitter-swift",
  "version": "0.1.0",
  "description": "Swift grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosSteve/tree-sitter-swift.git"
  },
  "license": "MIT",
  "author": {
    "name": "JosSteve",
    "email": "josephtuan99@gmail.com"
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "swift"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "0.27.1",
    "typescript": "^6.0.3",
    "@types/node": "^24.0.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "build": "tree-sitter generate && tree-sitter build",
    "test:grammar": "tree-sitter test",
    "test": "tree-sitter test && node --test bindings/node/*_test.js",
    "typecheck": "tsc",
    "smoke": "scripts/parse-repos.sh",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "compare": "scripts/compare-repos.sh"
  }
}
